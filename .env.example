# Runtime mode
APP_ENV=development
AUTH_REQUIRED=true
APP_BASE_URL=http://localhost:8505
# SESSION_SECRET is reserved for a future signed-token/session layer and is not currently used.

# Optional bootstrap administrator. Keep real values out of source control.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-10-characters

# Private, non-public storage for SQLite, uploaded documents, and ChromaDB.
MEDIGUARD_DB_PATH=data/mediguard.db
MEDIGUARD_STORAGE_DIR=data

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ibm/granite4.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=8
MAX_DOCUMENT_PAGES=10
MAX_FILE_MB=15
OCR_BACKEND=tesseract
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=mediguard_policy_clauses
CHROMA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
