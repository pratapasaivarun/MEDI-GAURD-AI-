# Local development configuration. Copy this file to .env and replace placeholders.
APP_ENV=development
MEDIGUARD_CORE_DEMO=true
AUTH_REQUIRED=true
APP_BASE_URL=http://localhost:8505

# Optional bootstrap administrator. Never commit real credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-10-characters

# Local, non-public application storage.
MEDIGUARD_DB_PATH=data/mediguard.db
MEDIGUARD_STORAGE_DIR=data
MEDIGUARD_BACKUP_KEY=replace-with-a-random-secret-at-least-32-characters
MEDIGUARD_MFA_KEY=replace-with-a-different-random-secret-at-least-32-characters
MEDIGUARD_RETENTION_DAYS=365

# Ollama runtime.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ibm/granite4.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=8

# Document extraction and policy retrieval.
MAX_DOCUMENT_PAGES=10
MAX_FILE_MB=15
OCR_BACKEND=tesseract
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=mediguard_policy_clauses
CHROMA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
