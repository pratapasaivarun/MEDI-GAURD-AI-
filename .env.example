# Local development configuration. Copy this file to .env and replace placeholders.
APP_ENV=development
MEDIGUARD_CORE_DEMO=false
MEDIGUARD_TRUSTED_FIXTURES=false
AUTH_REQUIRED=true
APP_BASE_URL=http://localhost:8501
MEDIGUARD_DEV_SHOW_LINKS=false

# Local, non-public application storage.
MEDIGUARD_DB_PATH=data/mediguard.db
MEDIGUARD_STORAGE_DIR=data
MEDIGUARD_RETENTION_DAYS=365

# Ollama runtime.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=ibm/granite4.1:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=8
OLLAMA_NUM_PARALLEL=1
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PREDICT=320

# Optional unstructured extraction fallback (bill fields, policy terms,
# settlement deductions). Deterministic extraction is the default.
MEDIGUARD_LLM_EXTRACTION_FALLBACK=false
MEDIGUARD_ANALYSIS_ENABLED=true
# Keep Ollama's local server at one inference request at a time; configure its
# server environment with OLLAMA_NUM_PARALLEL=1 for CPU-only machines.
# The gateway serializes MediGuard requests independently.

# Document extraction and policy retrieval.
MAX_DOCUMENT_PAGES=10
MAX_FILE_MB=15
OCR_BACKEND=tesseract
TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=mediguard_policy_clauses
CHROMA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HF_HOME=.venv/hf-cache
